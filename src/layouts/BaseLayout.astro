---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import type { MetaOutput } from '../lib/seo';

interface Props {
  meta: MetaOutput;
  lang?: string;
}

const { meta, lang = 'en' } = Astro.props;
const canonical = meta.canonical ?? Astro.url.href;
const ogImage   = meta.ogImage ?? new URL('/og-image.svg', Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Shehzad Anwar',
  url: 'https://shehzanwar.github.io',
  sameAs: [
    'https://github.com/shehzanwar',
    'https://linkedin.com/in/shehzanwar',
  ],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Georgia Institute of Technology' },
    { '@type': 'CollegeOrUniversity', name: 'Arizona State University' },
  ],
};
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={meta.description} />

    <!-- Fonts: Geist (display/body) + JetBrains Mono (code) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type"        content={meta.ogType} />
    <meta property="og:title"       content={meta.ogTitle} />
    <meta property="og:description" content={meta.ogDescription} />
    <meta property="og:url"         content={canonical} />
    <meta property="og:image"       content={ogImage} />
    {meta.articlePublishedTime && (
      <meta property="article:published_time" content={meta.articlePublishedTime} />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={meta.ogTitle} />
    <meta name="twitter:description" content={meta.ogDescription} />
    <meta name="twitter:image"       content={ogImage} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Favicons -->
    <link rel="icon"             type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon"             type="image/x-icon"  href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta name="theme-color" content="#13131b" />

    <title>{meta.title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
