---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import type { MetaOutput } from '../lib/seo';

interface Props {
  meta: MetaOutput;
  lang?: string | undefined;
}

const { meta, lang = 'en' } = Astro.props;
const canonical = meta.canonical ?? Astro.url.href;
const ogImage   = meta.ogImage ?? new URL('/og-image.png', Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Shehzad Anwar',
  jobTitle: 'Machine Learning & Data Analyst',
  url: 'https://shehzanwar.github.io',
  sameAs: [
    'https://github.com/shehzanwar',
    'https://linkedin.com/in/shehzanwar',
  ],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Georgia Institute of Technology' },
    { '@type': 'CollegeOrUniversity', name: 'Arizona State University' },
  ],
  knowsAbout: [
    'Bayesian Modeling',
    'Statistical Learning',
    'Machine Learning',
    'Monte Carlo Simulation',
    'Data Engineering',
  ],
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'CA',
    addressCountry: 'US',
  },
};
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={meta.description} />

    <!-- Fonts: Geist (display/body) + JetBrains Mono (code) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type"        content={meta.ogType} />
    <meta property="og:title"       content={meta.ogTitle} />
    <meta property="og:description" content={meta.ogDescription} />
    <meta property="og:url"         content={canonical} />
    <meta property="og:image"       content={ogImage} />
    {meta.articlePublishedTime && (
      <meta property="article:published_time" content={meta.articlePublishedTime} />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={meta.ogTitle} />
    <meta name="twitter:description" content={meta.ogDescription} />
    <meta name="twitter:image"       content={ogImage} />

    <!-- JSON-LD -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <!-- Favicons -->
    <link rel="icon"             type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon"             type="image/x-icon"  href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta name="theme-color" content="#13131b" />

    <title>{meta.title}</title>
    <ClientRouter />
  </head>
  <body>
    <slot />

    <script>
      // Spotlight card pointer tracking — sets --mx/--my consumed by .spotlight-card in global.css
      document.addEventListener('pointermove', (e) => {
        const target = e.target as HTMLElement;
        const card = target.closest?.('.spotlight-card') as HTMLElement | null;
        if (!card) return;
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - rect.left}px`);
        card.style.setProperty('--my', `${e.clientY - rect.top}px`);
      });

      // Scroll reveal — fade + rise on entry, respects prefers-reduced-motion
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function initScrollReveal() {
        const targets = document.querySelectorAll<HTMLElement>('.reveal-on-scroll');
        if (prefersReducedMotion || !('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-revealed'));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        targets.forEach((el) => observer.observe(el));
      }

      initScrollReveal();
      document.addEventListener('astro:page-load', initScrollReveal);
    </script>
  </body>
</html>
